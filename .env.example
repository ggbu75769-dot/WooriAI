NODE_ENV=development
PORT=3000
# 리버스 프록시 1홉 뒤에서 실 클라이언트 IP 인식 — Caddy/Fly 배포 시 필수 (per-IP rate limit 정상 동작 조건).
# 프록시 없이 직접 노출되는 환경에서는 0으로 (X-Forwarded-For 스푸핑 방지, 미설정 시 기본 꺼짐).
TRUST_PROXY=1
# Structured request-log verbosity: error | warn | info | debug (default info).
LOG_LEVEL=info
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# 어드민(Next.js). 기본값은 same-origin `/api/v1` — next.config.js의 rewrite가 실제 API로 넘기고,
# 그래야 admin_session/admin_csrf 쿠키가 same-origin으로 성립한다. 의도적으로 교차 출처 호출을
# 하는 구성에서만 절대 URL을 넣으세요(빈 값 = 기본값 사용).
NEXT_PUBLIC_API_BASE_URL=
# 위 rewrite가 가리킬 API 오리진(기본 http://localhost:3000).
ADMIN_API_PROXY_TARGET=http://localhost:3000
# AUTH-102 모바일 카카오 실로그인 (빌드타임 주입, 셋 다 설정 시에만 실 플로우 활성화)
# EXPO_PUBLIC_KAKAO_REDIRECT_URI는 카카오 콘솔과 OAUTH_KAKAO_REDIRECT_URIS 양쪽에 등록 필요
EXPO_PUBLIC_KAKAO_ENABLED=0
EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REDIRECT_URI=wooriai://oauth/kakao

DATABASE_URL=postgresql://wooriai:wooriai_dev_password@localhost:5432/wooriai_dev
REDIS_URL=redis://localhost:6379

# 백그라운드 워커 경량 스케줄러(INF-006-lite). 1로 설정한 프로세스에서만 주기 작업 실행(기본 꺼짐 — 다중 인스턴스 중 하나만 켜세요).
WORKER_ENABLED=0
# 워커 틱 간격(ms). 기본 60000(1분).
WORKER_INTERVAL_MS=60000
# 만료/폐기된 refresh token 보존 기간(일). 이 기간이 지난 뒤 삭제(기본 30일).
WORKER_TOKEN_RETENTION_DAYS=30
# 삭제 처리(소프트 삭제/탈퇴)된 데이터의 물리 파기 유예 기간(일, PRIV-105 data_retention_purge 잡).
# 이 기간이 지난 지출·아이 프로필·탈퇴 계정을 DB에서 완전 삭제(기본 30일).
# 개인정보처리방침(infra/legal/*.html)의 "30일이 경과하면 지체 없이 완전 파기" 문구와 일치해야 하므로 변경 시 문서도 함께 갱신.
PURGE_RETENTION_DAYS=30
# 파기 잡의 틱 1회당 엔티티별 최대 처리 행 수(틱 시간 상한, 기본 200).
PURGE_BATCH_SIZE=200
# 잡이 몇 틱 연속 실패하면 /health/worker 응답이 degraded=true가 되는지(OPS-130, 기본 3).
# 1로 낮추면 일시적 실패에도 알림이 울려 모니터를 무시하게 되므로 권장하지 않음.
WORKER_JOB_FAILURE_THRESHOLD=3
# 텔레메트리 보존 기간(일, SEC-130 data_retention_purge 잡 phase 6·7). 위 PURGE_RETENTION_DAYS와
# 별개 — 이 두 테이블은 삭제 표식이 아니라 살아있는 로그라서 시간 기준으로만 정리된다.
# 기본 400일(≈13개월): 전년 동기 비교·제휴 정산 클레임(클릭 몇 달 뒤 조정 가능)을 감안해 넉넉히 잡았다.
# 줄이면 되돌릴 수 없는 삭제이므로 정산/통계 담당과 합의 후 변경할 것.
ANALYTICS_EVENTS_RETENTION_DAYS=400
AFFILIATE_CLICKS_RETENTION_DAYS=400
# 감사 로그 보존 기간(일, GAP-058 #10 data_retention_purge 잡 phase 8). 기본 730일(2년) —
# 텔레메트리(400일)보다 **일부러 길다**: audit_logs는 정산 substrate가 아니라 책임 추적 기록이고
# ("누가 이 금액을 바꿨나") 그 질문은 늦게 도착한다(CS 분쟁·내부 점검·이용자 문의).
# ⚠️ 짧게 조정하는 것은 PM/법무 확인 대상 — 되돌릴 수 없는 삭제이고, 기간은 개인정보처리방침·
# 내부 감사 정책이 함께 정하는 값이다. 늘리는 방향은 안전하다.
AUDIT_LOGS_RETENTION_DAYS=730
# 엑셀/CSV 가져오기의 **검수용 행** 보존 기간(일, GAP-060 #5 data_retention_purge 잡 phase 9).
# 기본 90일(한 분기) — 위 두 창보다 **일부러 짧다**: import_rows는 정산 근거도 책임 추적 기록도
# 아니고, 사용자가 승인하지 않은 줄까지 담은 금융 내역의 사본이라 오래 둘수록 손해다.
# 90일을 두는 유일한 이유는 CS 조회 가능성("가져왔는데 3건이 빠졌어요" — 무엇이 파싱됐고
# 무엇이 선택 해제됐는지는 이 행에만 있다). 확정(confirmed)·실패(failed) 잡만 대상이고,
# 검수 중(preview_ready)인 잡의 행은 사용자 자산이라 건드리지 않는다.
# ⚠️ 짧게 조정하는 것은 PM/법무 확인 대상 — 개인정보처리방침 §3이 "90일"을 그대로 말하고 있어
# 코드에서 혼자 줄이면 문서가 거짓이 된다. 늘리는 방향도 개인정보를 더 오래 들고 있는 것이라
# 단독 결정 대상이 아니다.
IMPORT_ROWS_RETENTION_DAYS=90
# **상태가 정해진 가족 초대 행** 보존 기간(일, GAP-062 #8 data_retention_purge 잡 phase 10).
# 기본 90일 — 기준점은 초대의 유효기간(expires_at)이고, 초대 수명 자체는 7일이라 그 13배의
# 사후 조회 창이다("초대 링크를 보냈는데 왜 안 되나요" CS는 만료/취소/이미 수락을 이 행에서 읽는다).
# 만료(expired)·수락(accepted)·취소(revoked)만 대상이고 **pending은 절대 지우지 않는다** — 아직
# 살아 있는 링크다. 이 행이 사라져도 사실은 남는다: 수락은 household_members 행이, 취소는 감사 로그
# household.invite.cancel(730일 창)이 각각 보존한다 — 그래서 이 삭제는 중복 보존의 해소다.
# ⚠️ 짧게 조정하는 것은 PM 확인 대상 — 되돌릴 수 없는 삭제이고 위 CS 조회 창이 그대로 줄어든다.
HOUSEHOLD_INVITES_RETENTION_DAYS=90
# 만료·폐기된 **어드민 세션 행** 보존 기간(일, 라운드 61 #7 admin_session_cleanup 잡).
# 기본 30일: 어드민 세션 자체는 12시간 절대 만료(SEC-102)라 30일은 그 60배의 사후 조사 창이다.
# 이 행을 지워도 **로그인 이력은 남는다** — admin.login/login_failed/mfa_login_failed는 audit_logs에
# 기록되고 그쪽 보존 창은 730일(AUDIT_LOGS_RETENTION_DAYS)이다. 여기서 사라지는 것은 그 세션의
# 운영 세부(token_hash·last_seen_at·ip·user_agent)뿐이다.
# 다른 보존 값들과 달리 **늘리는 쪽이 위험한 방향**이다: ip·user_agent가 원문으로 실린 행을 더 오래
# 들고 있게 된다(감사 로그의 ip_hash는 소금친 단방향 해시라 성격이 다르다).
ADMIN_SESSIONS_RETENTION_DAYS=30
# FCM 푸시 발송 스캐폴드(PUSH-113). 두 값이 모두 유효할 때만 실제 발송 —
# 아니면 push 모듈은 로드되되 발송은 안전한 no-op이고 부팅 시 1회 안내 로그만 남습니다.
PUSH_ENABLED=0
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정에서 발급한 JSON의 "파일 경로"(내용 아님).
# 파일 내용/private key는 코드·로그 어디에도 넣지 마세요(DNC-019) — 로그에는 경로만 남습니다.
FCM_SERVICE_ACCOUNT_PATH=
EXPO_PUBLIC_PUSH_ENABLED=0
# 약관·처리방침 호스팅 URL — 비우면 앱에 [보기] 링크가 생기지 않아요(GAP-065 #5).
# 처리방침은 Play 등록 URL과 같은 값을 쓰세요(docs/store/play-listing.md).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# 지원·FAQ 페이지 호스팅 URL(SITE-113 — infra/site/support.html · faq.html).
# 비우면 더보기·설정에 그 두 행이 서지 않아요 = 앱 안에 도움으로 가는 길이 0건이에요.
# 지원 URL은 Play Console의 지원 URL과 같은 값을 쓰세요(docs/store/play-listing.md).
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_FAQ_URL=
# FCM 외부 HTTP 타임아웃(ms, RES-130). 구글 OAuth 토큰 발급 5초 / 실제 발송 10초가 기본값 —
# 미설정이거나 숫자가 아니거나 0 이하이면 기본값을 씁니다. 타임아웃은 예외가 아니라 기존 발송 실패로 집계됩니다.
FCM_TOKEN_HTTP_TIMEOUT_MS=5000
FCM_SEND_HTTP_TIMEOUT_MS=10000

# 제휴 링크 헬스체크 잡(COM-105). 워커에서 외부 네트워크 요청을 보내므로 opt-in — 1로 설정한 프로세스에서만 실행(기본 꺼짐).
LINK_HEALTH_ENABLED=0
# 링크별 재확인 주기(시간). 마지막 확인이 이 시간보다 오래된 링크만 다시 검사(기본 24시간). unstable 판정은 다음 틱에 바로 재시도.
LINK_HEALTH_INTERVAL_HOURS=24
# 워커 틱 1회당 검사할 최대 링크 수(틱 시간 상한, 기본 10개).
LINK_HEALTH_BATCH=10

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wooriai-local
S3_ACCESS_KEY_ID=wooriai-local
S3_SECRET_ACCESS_KEY=change-me-local-only

# 가족 초대 링크의 베이스 URL (프로덕션에서는 실제 서비스 도메인으로 교체, 예: https://wooriai.app)
INVITE_LINK_BASE_URL=https://wooriai.local

JWT_ACCESS_SECRET=change-me-local-only-access
JWT_REFRESH_SECRET=change-me-local-only-refresh
# SEC-131: refresh 토큰 세션(family)의 절대 수명(일). 회전할 때마다 refresh 토큰의
# 만료가 30일 뒤로 다시 밀리기 때문에, 이 상한이 없으면 로그인 한 번이 영구 세션이 된다.
# 최초 로그인 시각 기준으로 이 기간을 넘기면 회전이 401로 거부되고 재로그인이 필요하다.
# (미설정/0 이하/비수치는 기본값 90일)
REFRESH_FAMILY_MAX_AGE_DAYS=90

# Legacy shared-secret admin header (x-admin-token). Only ever honored when
# NODE_ENV is "development" or "test" — production admin access requires the
# per-admin JWT issued by POST /admin/auth/login. Dev/test convenience only.
WOORIAI_ADMIN_TOKEN=dev-admin-token
# Seeds one AdminUser (role=admin) via `pnpm seed`. If unset, development seeds a
# default admin@wooriai.local / wooriai-dev-admin account; production requires
# both to be set or the admin seed step is skipped.
ADMIN_SEED_EMAIL=admin@wooriai.local
ADMIN_SEED_PASSWORD=wooriai-dev-admin

OAUTH_KAKAO_CLIENT_ID=dev-kakao-client-id
OAUTH_APPLE_CLIENT_ID=dev-apple-client-id
OAUTH_GOOGLE_CLIENT_ID=dev-google-client-id
# Kakao OIDC 서버 검증(AUTH-101). client secret은 카카오 콘솔에서 발급(선택 기능이면 빈 값 가능).
OAUTH_KAKAO_CLIENT_SECRET=change-me-local-only
# 허용 redirect URI 목록(csv). 앱 딥링크/개발용 주소를 나열.
OAUTH_KAKAO_REDIRECT_URIS=wooriai://oauth/kakao,http://localhost:8081/oauth/kakao
# 카카오 코드↔토큰 교환 HTTP 타임아웃(ms, RES-130). 기본 5000 —
# 미설정이거나 숫자가 아니거나 0 이하이면 기본값을 씁니다. 타임아웃은 기존 로그인 실패(401)로 처리됩니다.
KAKAO_HTTP_TIMEOUT_MS=5000

AFFILIATE_DISCLOSURE_TEXT=이 링크로 구매하면 우리아이가 수수료를 받을 수 있어요.
# 제휴 redirect(/r/{code}) 허용 도메인(csv, 서브도메인 포함 매칭)과 클릭 IP 해시 salt (COM-106).
AFFILIATE_ALLOWED_DOMAINS=coupang.com,link.coupang.com,smartstore.naver.com,shopping.naver.com,brand.naver.com
AFFILIATE_CLICK_IP_SALT=change-me-local-only
# 레이트리밋 공통 창(ms)과 버킷별 상한(SEC-130). 모두 미설정이 정상 — 아래 값은 코드 기본값과
# 같으며, 0 이하/비수치는 무시되고 기본값이 쓰인다. TRUST_PROXY가 꺼져 있으면 프록시 뒤에서
# 모든 요청이 한 IP로 집계되므로 이 값들만 올려도 오차단이 낫지 않는다.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_REDIRECT_MAX=60
# 분석 이벤트 익명 식별자 HMAC salt (ANA-101).
ANALYTICS_ANON_SALT=change-me-local-only
# POST /api/v1/analytics/events 전용 per-IP 분당 상한(SEC-130, 기본 60).
# 요청 1건이 최대 50행을 INSERT하므로 전역 상한(300/분)만으로는 IP당 15,000행/분까지 가능해진다.
# SEC-132에서 30 → 60으로 완화: 캐리어 NAT 뒤에서는 수백 대가 한 IP를 공유해 오차단이 나는데,
# 인증된 쓰기는 아래 계정 단위 버킷을 반드시 통과하므로 IP 버킷은 비인증/위조 토큰 폭주만
# 막으면 된다(그마저 전역 300/분이 이미 덮는다).
RATE_LIMIT_ANALYTICS_MAX=60
# 같은 엔드포인트의 계정(JWT sub) 단위 분당 상한(SEC-132, 기본 60). IP 버킷과 AND —
# 둘 중 하나라도 넘으면 429. IP는 바꿀 수 있어 IP 버킷만으로는 토큰 1개를 여러 IP로
# 돌리는 남용을 막지 못한다. 모바일은 수 분 간격 배치 전송이라 기기당 1회/분 미만.
RATE_LIMIT_ANALYTICS_USER_MAX=60
