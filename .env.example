NODE_ENV=development
PORT=3000
# Structured request-log verbosity: error | warn | info | debug (default info).
LOG_LEVEL=info
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

DATABASE_URL=postgresql://wooriai:wooriai_dev_password@localhost:5432/wooriai_dev
REDIS_URL=redis://localhost:6379
RATE_LIMIT_KEY_SALT=change-me-local-only
INTERNAL_METRICS_TOKEN=change-me-local-only

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wooriai-local
S3_ACCESS_KEY_ID=wooriai-local
S3_SECRET_ACCESS_KEY=change-me-local-only

JWT_ACCESS_SECRET=change-me-local-only-access
JWT_REFRESH_SECRET=change-me-local-only-refresh

# Legacy shared-secret admin header (x-admin-token). Only ever honored when
# NODE_ENV is "development" or "test" — production admin access requires the
# per-admin JWT issued by POST /admin/auth/login. Dev/test convenience only.
WOORIAI_ADMIN_TOKEN=dev-admin-token
# Seeds one AdminUser (role=admin) via `pnpm seed`. If unset, development seeds a
# default admin@wooriai.local / wooriai-dev-admin account; production requires
# both to be set or the admin seed step is skipped.
ADMIN_SEED_EMAIL=admin@wooriai.local
ADMIN_SEED_PASSWORD=wooriai-dev-admin

OAUTH_KAKAO_CLIENT_ID=dev-kakao-client-id
OAUTH_APPLE_CLIENT_ID=dev-apple-client-id
OAUTH_GOOGLE_CLIENT_ID=dev-google-client-id
# Kakao OIDC 서버 검증(AUTH-101). client secret은 카카오 콘솔에서 발급(선택 기능이면 빈 값 가능).
OAUTH_KAKAO_CLIENT_SECRET=change-me-local-only
# 허용 redirect URI 목록(csv). 앱 딥링크/개발용 주소를 나열.
OAUTH_KAKAO_REDIRECT_URIS=wooriai://oauth/kakao,http://localhost:8081/oauth/kakao

AFFILIATE_DISCLOSURE_TEXT=이 링크로 구매하면 우리아이가 수수료를 받을 수 있어요.
# 제휴 redirect(/r/{code}) 허용 도메인(csv, 서브도메인 포함 매칭)과 클릭 IP 해시 salt (COM-106).
AFFILIATE_ALLOWED_DOMAINS=coupang.com,link.coupang.com,smartstore.naver.com,shopping.naver.com,brand.naver.com
AFFILIATE_CLICK_IP_SALT=change-me-local-only
# 분석 이벤트 익명 식별자 HMAC salt (ANA-101).
ANALYTICS_ANON_SALT=change-me-local-only
PRIVACY_STATUS_TOKEN_SECRET=change-me-local-only
PRIVACY_HASH_SALT=change-me-local-only
DEVICE_ID_HASH_SALT=change-me-local-only

# Release 3 production contract. Safe feature defaults stay OFF until the
# production release gate and external integration evidence are complete.
ENABLE_DEV_AUTH=false
LEGAL_OPERATOR_NAME=change-me-approved-operator
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms
SUPPORT_URL=https://example.com/support
STATUS_PAGE_URL=https://example.com/status
ANALYTICS_OPT_IN_DEFAULT=false
FEATURE_ANALYTICS_DEFAULT=false
FEATURE_AFFILIATE_DEFAULT=false
FEATURE_IMPORT_DEFAULT=false
FEATURE_NOTIFICATION_DEFAULT=false
OAUTH_PROVIDER_ADAPTER=mock
QUEUE_ADAPTER=memory
OBJECT_STORAGE_ADAPTER=memory
PRIVACY_PROCESSOR_MODE=mock
NOTIFICATION_PROVIDER_MODE=mock
ANDROID_SIGNING_KEYSTORE_PATH=change-me-external-path
ANDROID_SIGNING_KEY_ALIAS=change-me-alias
ANDROID_SIGNING_STORE_PASSWORD_ENV=ANDROID_SIGNING_STORE_PASSWORD
ANDROID_SIGNING_KEY_PASSWORD_ENV=ANDROID_SIGNING_KEY_PASSWORD
RELEASE_EXPECTED_MIGRATION_HEAD=000012_release3_foundation
CONTRACT_GENERATION_CHECK=not-run
