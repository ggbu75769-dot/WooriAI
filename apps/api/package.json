{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/api-foundation.e2e.test.ts test/onboarding.e2e.test.ts test/expense-home-report.e2e.test.ts test/items-commerce.e2e.test.ts test/family-invite.e2e.test.ts test/import-excel.e2e.test.ts test/admin-settings.e2e.test.ts test/admin-mfa-session.e2e.test.ts test/core-loop.e2e.test.ts test/sync-changes.e2e.test.ts test/content-revisions.e2e.test.ts test/auth-kakao-oidc.e2e.test.ts test/affiliate-redirect.e2e.test.ts test/analytics-events.e2e.test.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "@wooriai/contracts": "workspace:*",
    "@wooriai/domain": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "jose": "^5.9.6",
    "otplib": "^13.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0"
  }
}
