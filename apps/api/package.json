{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsx ../../scripts/build-api.ts",
    "start:prod": "node dist/main.cjs",
    "start:publisher": "node dist/publisher.cjs",
    "start:worker": "node dist/worker.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:admin-browser": "vitest run --config vitest.browser.config.mts",
    "catalog:validate": "tsx scripts/catalog.ts validate",
    "catalog:audit": "tsx scripts/catalog.ts audit",
    "catalog:coverage": "tsx scripts/catalog.ts coverage",
    "release4c:evidence": "tsx scripts/release4c-evidence.ts",
    "catalog:import": "tsx scripts/catalog.ts import",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1088.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^6.1.0",
    "@wooriai/contracts": "workspace:*",
    "@wooriai/domain": "workspace:*",
    "bullmq": "^5.61.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.8.2",
    "jose": "^5.9.6",
    "otplib": "^13.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0"
  }
}
