  passwordHash     String    @map("password_hash") @db.VarChar(255)
  displayName      String    @map("display_name") @db.VarChar(80)
  role             AdminRole
  active           Boolean   @default(true)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  totpSecret       String?   @map("totp_secret") @db.Text
  mfaEnabledAt     DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)
  mfaRecoveryCodes Json?     @map("mfa_recovery_codes") @db.JsonB

  @@map("admin_users")
}

model IdempotencyKey {
