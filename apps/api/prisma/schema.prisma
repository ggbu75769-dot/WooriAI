generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  kakao
  apple
  google

  @@map("auth_provider")
}

enum UserStatus {
  active
  withdrawn
  blocked

  @@map("user_status")
}

enum MemberRole {
  owner
  co_parent
  viewer
  gift_participant

  @@map("member_role")
}

enum MemberStatus {
  pending
  active
  removed
  left

  @@map("member_status")
}

enum ChildStageMode {
  pregnant
  born
  manual

  @@map("child_stage_mode")
}

enum ChildStageCode {
  pregnancy_early
  pregnancy_mid
  pregnancy_late
  newborn_0_3
  infant_4_6
  infant_7_12
  toddler_1_3
  kid_4_7
  elementary
  middle_school

  @@map("child_stage_code")
}

enum ExpenseSource {
  manual
  excel_import
  purchase_followup
  admin

  @@map("expense_source")
}

enum ExpenseType {
  expense
  gift
  refund

  @@map("expense_type")
}

enum PaymentMethod {
  unknown
  cash
  card
  transfer
  mobile_pay

  @@map("payment_method")
}

enum NecessityLevel {
  essential
  convenience
  optional

  @@map("necessity_level")
}

enum ItemStatus {
  not_prepared
  prepared
  gifted
  not_needed
  interested

  @@map("item_status")
}

enum ProductPlatform {
  coupang
  naver
  custom

  @@map("product_platform")
}

enum ImportStatus {
  uploaded
  analyzing
  preview_ready
  confirmed
  failed
  cancelled

  @@map("import_status")
}

enum AdminRole {
  admin
  editor
  analyst

  @@map("admin_role")
}

model User {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authProvider    AuthProvider @map("auth_provider")
  providerUserId  String       @map("provider_user_id") @db.VarChar(191)
  email           String?      @db.VarChar(320)
  phone           String?      @db.VarChar(32)
  displayName     String?      @map("display_name") @db.VarChar(80)
  profileImageUrl String?      @map("profile_image_url") @db.Text
  status          UserStatus   @default(active)
  lastLoginAt     DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@unique([authProvider, providerUserId], map: "uq_users_provider")
  @@index([email], map: "idx_users_email")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model UserDevice {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  platform            String   @db.VarChar(20)
  deviceIdHash        String?  @map("device_id_hash") @db.VarChar(128)
  pushToken           String?  @map("push_token") @db.Text
  notificationEnabled Boolean  @default(false) @map("notification_enabled")
  appVersion          String?  @map("app_version") @db.VarChar(32)
  osVersion           String?  @map("os_version") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, pushToken], map: "uq_user_devices_user_push_token")
  @@index([userId], map: "idx_user_devices_user_id")
  // PERF-119 (000015): claimPushToken의 push_token 단독 술어용. 위 복합 유니크는
  // 선두 컬럼이 user_id라 이 술어를 태울 수 없다 — 마이그레이션 헤더에 실측 근거.
  @@index([pushToken], map: "idx_user_devices_push_token")
  @@map("user_devices")
}

model Household {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @db.VarChar(80)
  ownerUserId    String    @map("owner_user_id") @db.Uuid
  defaultChildId String?   @map("default_child_id") @db.Uuid
  status         String    @default("active") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerUserId], map: "idx_households_owner_user_id")
  @@map("households")
}

model HouseholdMember {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String       @map("household_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  role            MemberRole
  status          MemberStatus @default(active)
  invitedByUserId String?      @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime?    @map("joined_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([householdId, userId], map: "uq_household_members_user")
  @@index([userId], map: "idx_household_members_user_id")
  @@index([householdId, role, status], map: "idx_household_members_household_role")
  @@map("household_members")
}

/// GAP-062 #8 보존: `status`가 정해진 행(expired·accepted·revoked)은 파기 잡 phase 10이
/// `expires_at` 기준 90일(HOUSEHOLD_INVITES_RETENTION_DAYS) 뒤 삭제한다. `pending`은 대상이
/// 아니다 — 아직 살아 있는 링크다. 그래서 `expires_at` 인덱스는 만료 표시 UPDATE와 그 파기
/// 단계가 함께 쓴다(근거·남는 격차는 data-retention-purge.job.ts의 phase 10 주석).
model HouseholdInvite {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      String     @map("household_id") @db.Uuid
  invitedByUserId  String     @map("invited_by_user_id") @db.Uuid
  role             MemberRole
  inviteTokenHash  String     @unique @map("invite_token_hash") @db.VarChar(128)
  channel          String     @db.VarChar(20)
  status           String     @default("pending") @db.VarChar(20)
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedByUserId String?    @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?  @map("accepted_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([householdId, status], map: "idx_household_invites_household_status")
  @@index([expiresAt], map: "idx_household_invites_expires_at")
  @@map("household_invites")
}

model Child {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId     String          @map("household_id") @db.Uuid
  nickname        String          @db.VarChar(60)
  stageMode       ChildStageMode  @map("stage_mode")
  dueDate         DateTime?       @map("due_date") @db.Date
  birthDate       DateTime?       @map("birth_date") @db.Date
  manualStage     ChildStageCode? @map("manual_stage")
  /// ⚠️ 죽은 컬럼(GAP-067 #8에서 확인). 제품 코드에서 **읽지도 쓰지도 않는다** — 앱의
  /// 아이 등록/수정 폼에도, 온보딩 서비스에도, 어떤 DTO에도 없다. 저장소에서 이 이름이
  /// 나오는 곳은 어드민 조회 e2e 픽스처 한 곳(`"female"`을 넣어 두고, 같은 파일이 응답에
  /// 이 값이 **새지 않는지** 단언한다)뿐이라, 실제로 이 컬럼은 언제나 NULL이다.
  /// **"아이 성별을 안다"의 근거로 인용하지 말 것** — 준비템 랭킹(item-ranking)도
  /// 시기 판정(stage)도 성별을 보지 않는다.
  /// 소생시키지 않은 이유: 성별은 수집하지 않아도 되는 개인정보이고(수집 최소화),
  /// 그것을 받으려면 동의·표시·수정 경로가 함께 생겨야 한다 — 컬럼을 채우는 일이 아니라
  /// 기능을 만드는 일이다. 없애지 않은 이유: `children`은 **DNC-007이 지키는 도메인**이라
  /// 파괴적 변경에 변경 요청이 먼저다(`attachments`와 다른 점이다 — 그 표의 주석 참고).
  gender          String?         @db.VarChar(20)
  profileImageUrl String?         @map("profile_image_url") @db.Text
  preparedItemsSetAt DateTime?    @map("prepared_items_set_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)

  @@index([householdId], map: "idx_children_household_id")
  @@index([stageMode], map: "idx_children_stage_mode")
  @@map("children")
}

model Category {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// ⚠️ 죽은 컬럼(GAP-067 #8에서 확인). 저장소 전체에서 **읽지도 쓰지도 않는다** — 시드도
  /// 채우지 않고(prisma/seed.ts) 어드민 편집 DTO는 이 필드를 의도적으로 뺐다고 적어 둘 뿐이라
  /// (`admin/dto/admin-categories.dto.ts`) 값은 **언제나 NULL**이다. 마이그레이션 000001의
  /// 자기참조 FK만 남아 있다.
  /// **"카테고리에 계층이 있다"의 근거로 인용하지 말 것** — 앱도 어드민도 카테고리를 평면
  /// 목록으로만 다루고, 정렬 축은 `displayOrder`, 노출 축은 `active`/`selectable`이다.
  /// 소생시키지 않은 이유: 계층을 실제로 쓰려면 조회·집계·리포트가 전부 "부모로 접기"를
  /// 알아야 하는데(카테고리 리포트는 지금 평면 합계다), 그것은 컬럼 하나가 아니라 리포트
  /// 계약의 변경이다. 없애려면 파괴적 마이그레이션이므로 별도 티켓 대상이다.
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(50)
  iconName         String?  @map("icon_name") @db.VarChar(50)
  displayOrder     Int      @default(0) @map("display_order")
  isSystem         Boolean  @default(true) @map("is_system")
  active           Boolean  @default(true)
  // CAT-124: 사용자에게 "고르라고" 내밀 카테고리인지. `active`(행이 살아 있는가)와도,
  // `isSystem`(시스템 시드인가)과도 다른 축이다 — 모바일 퀵타일 별칭 8행과 엑셀 가져오기
  // 스텁 1행은 시스템이 만든 살아 있는 행이지만 선택지로 내밀면 안 된다(정식 12개와 뜻이
  // 겹친다). `GET /categories`는 기본적으로 selectable=true만 돌려주고 `?includeAll=1`이
  // 전량을 돌려준다. 지출의 categoryId 검증은 이 플래그를 보지 않는다(하위 호환).
  // 마이그레이션: 000018_categories_selectable.
  selectable       Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, displayOrder], map: "idx_categories_active_order")
  @@map("categories")
}

model ItemTemplate {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                      String         @unique @db.VarChar(80)
  name                      String         @db.VarChar(80)
  categoryId                String?        @map("category_id") @db.Uuid
  necessityLevel            NecessityLevel @map("necessity_level")
  timingLabel               String?        @map("timing_label") @db.VarChar(80)
  priceMinKrw               Int?           @map("price_min_krw")
  priceMaxKrw               Int?           @map("price_max_krw")
  reasonText                String         @map("reason_text") @db.Text
  skipReasonText            String?        @map("skip_reason_text") @db.Text
  usedSecondhandOk          Boolean        @default(false) @map("used_secondhand_ok")
  safetyNote                String?        @map("safety_note") @db.Text
  medicalDisclaimerRequired Boolean        @default(false) @map("medical_disclaimer_required")
  displayOrder              Int            @default(0) @map("display_order")
  active                    Boolean        @default(true)
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active, displayOrder], map: "idx_item_templates_active_order")
  @@map("item_templates")
}

model ItemTemplateStage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemTemplateId String         @map("item_template_id") @db.Uuid
  stageCode      ChildStageCode @map("stage_code")
  priorityWeight Int            @default(0) @map("priority_weight")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([itemTemplateId, stageCode], map: "uq_item_template_stage")
  @@index([stageCode, priorityWeight], map: "idx_item_template_stages_stage")
  @@map("item_template_stages")
}

model Expense {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId          String        @map("household_id") @db.Uuid
  childId              String        @map("child_id") @db.Uuid
  createdByUserId      String        @map("created_by_user_id") @db.Uuid
  categoryId           String        @map("category_id") @db.Uuid
  amountKrw            Int           @map("amount_krw")
  spentOn              DateTime      @map("spent_on") @db.Date
  itemName             String        @map("item_name") @db.VarChar(120)
  merchant             String?       @db.VarChar(120)
  paymentMethod        PaymentMethod @default(unknown) @map("payment_method")
  expenseType          ExpenseType   @default(expense) @map("expense_type")
  source               ExpenseSource @default(manual)
  memo                 String?       @db.Text
  linkedItemTemplateId String?       @map("linked_item_template_id") @db.Uuid
  linkedProductLinkId  String?       @map("linked_product_link_id") @db.Uuid
  /// GAP-066 #5 — 이 지출이 **어느 가져오기에서** 들어왔는지(`import_jobs.id`). NULL이면
  /// 가져오기로 생긴 행이 아니라는 뜻이다(수동 기록·아웃박스·"샀어요" 경로 전부 NULL).
  /// 쓰는 곳은 하나뿐이다: `ImportPipelineService.confirmImport`가 확정 트랜잭션 안에서
  /// `ExpensesStoreService.insertExpense`에 자기 잡 id를 넘긴다. 컬럼과 FK
  /// (`fk_expenses_import_job`)는 000001부터 있었고 채우는 곳만 없어 **언제나 NULL**이었다.
  /// 라운드 66 이전 기록에는 소급해 채우지 않는다 — 어느 행이 어느 잡에서 왔는지 알 방법이
  /// 없고, 추측으로 채우면 서버가 모르는 과거를 지어내는 것이 된다(그래서 옛 가져오기 행은
  /// NULL로 남는다. `source = "excel_import"`인데 이 값이 NULL이면 그 시절 행이다).
  ///
  /// **무엇을 위해 채우는가.** `source`는 "엑셀 가져오기"라는 **경로**만 말하고 어느 파일인지는
  /// 말하지 않아, 잘못 확정한 200행을 특정할 근거가 0이었다(지난달 파일에서 온 행과 오늘
  /// 파일에서 온 행이 구별되지 않는다). 이 값이 있으면 CS는 잡 id 하나로 그 묶음을 셀 수 있고,
  /// 다음 라운드가 **되돌리기(일괄 soft delete)** 를 이 위에 세울 수 있다.
  ///
  /// 지금은 **쓰기 전용**이다 — 어떤 응답 DTO에도 실리지 않는다(`store-shared.ts`의
  /// `toExpenseDto`는 이 필드를 모른다). 화면이 출처를 어떻게 말할지는 되돌리기 설계와 함께
  /// 정한다(`import_jobs.approved_at`이 라운드 64에서 밟은 순서 그대로).
  ///
  /// ⚠️ 파기 판정에 쓰이지 않는다: phase 9(미리보기 행 삭제)·phase 11(잡 헤더 마스킹)은 둘 다
  /// `import_jobs.updated_at`을 정렬·컷오프 컬럼으로 쓴다(data-retention-purge.job.ts).
  /// 다만 파기의 **삭제 순서**에는 실체가 생겼다 — `purgeChildRows`가 잡보다 지출을 먼저 지우는
  /// 것은 이제 실제로 걸리는 FK다(종전에는 언제나 NULL인 컬럼을 위한 방어였다). phase 11은
  /// 잡 행을 남기고 파일명만 마스킹하므로 이 FK와 무관하다.
  importJobId          String?       @map("import_job_id") @db.Uuid
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId      String?       @map("deleted_by_user_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int           @default(1)

  // SQL 전용 부분 인덱스(Prisma @@index 표현 불가) 3건이 별도로 존재한다:
  //   idx_expenses_not_deleted (child_id, spent_on) WHERE deleted_at IS NULL (000001)
  //   idx_expenses_deleted_purge (deleted_at, id) WHERE deleted_at IS NOT NULL (000011, PERF-101)
  //   idx_expenses_list_keyset (child_id, spent_on DESC, created_at DESC, id DESC)
  //     WHERE deleted_at IS NULL (000017, R24-M3) — 지출 목록 keyset 정렬 계약
  //     (spent_on DESC, created_at DESC, id DESC)과 컬럼·방향 일치. 정의 계약은
  //     apps/api/test/perf-indexes.db.test.ts의 R24-M3 블록이 고정한다.
  @@index([childId, spentOn], map: "idx_expenses_child_spent_on")
  @@index([householdId, childId], map: "idx_expenses_household_child")
  @@index([categoryId], map: "idx_expenses_category")
  // PERF-101(000011): 델타 동기화 keyset((updatedAt,id) 커서, 가구 스코프) 전용.
  @@index([householdId, updatedAt, id], map: "idx_expenses_household_updated")
  // PERF-115(000014): 파기 워커의 created_by_user_id 안티조인/참조 차단 검사용
  // (data-retention-purge.job.ts selectPurgeableStubs · findReferenceBlockedUserIds).
  @@index([createdByUserId], map: "idx_expenses_created_by")
  @@map("expenses")
}

/// 아이의 월 예산. `(child_id, year_month)`가 유니크한 **한 칸**이라 이월도 이력도 없고,
/// 덮어쓰면 이전 금액은 행에서 사라진다.
///
/// GAP-063 #5: 그래서 `PUT /children/:childId/budget`은 덮어쓸 때마다 `budget.upsert`
/// 감사 로그를 남긴다(`onboarding/budgets.controller.ts` — before/after에 금액·연월·childId만).
/// "마지막으로 바꾼 사람"을 이 행에 담으려면 `updated_by_user_id` 컬럼 신설 = 마이그레이션이
/// 필요한데, 그 사실은 audit_logs가 이미 답한다(행위자 = actor_user_id, 시각 = created_at).
/// ⚠️ 그러므로 아래 `created_by_user_id`를 "이 예산을 정한 사람"으로 읽지 말 것 —
/// **처음 만든 사람**이고, upsert의 update 분기는 이 값을 건드리지 않는다.
model Budget {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId         String   @map("child_id") @db.Uuid
  yearMonth       DateTime @map("year_month") @db.Date
  amountKrw       Int      @map("amount_krw")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([childId, yearMonth], map: "uq_budgets_child_month")
  @@index([childId, yearMonth], map: "idx_budgets_child_month")
  @@map("budgets")
}

// PUSH-113 후속(리뷰 M-2): 예산 경계(80/100) 푸시 발송 클레임 — (아이, 월, 경계)당
// 1행. unique 제약을 INSERT로 선점(claim)한 요청만 발송해 동시 지출 레이스에서의
// 중복/누락을 구조적으로 제거한다. child_id는 SQL FK(ON DELETE CASCADE, 000013)로
// 아이 물리 파기 시 함께 삭제된다 (schema.prisma는 관계 미선언 관례 — 000001 참조).
model PushBoundaryMark {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId   String   @map("child_id") @db.Uuid
  /// 'YYYY-MM' (Asia/Seoul 기준 월).
  yearMonth String   @map("year_month") @db.VarChar(7)
  /// 경계 백분율: 80 또는 100.
  boundary  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([childId, yearMonth, boundary], map: "uq_push_boundary_marks")
  @@map("push_boundary_marks")
}

model ChildItemStatus {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  childId        String     @map("child_id") @db.Uuid
  itemTemplateId String     @map("item_template_id") @db.Uuid
  status         ItemStatus @default(not_prepared)
  expenseId      String?    @map("expense_id") @db.Uuid
  /// ⚠️ 죽은 컬럼(GAP-065 #9가 지목하고 GAP-067 #8이 함께 문서화). 저장소 전체에서
  /// **읽지도 쓰지도 않는다** — 상태 토글 API(`PUT /children/:childId/items/:itemTemplateId`)에
  /// 메모 입력이 없고, 준비템 응답 DTO에도 실리지 않으며, 시드도 채우지 않는다. 값은 언제나
  /// NULL이다.
  /// **"이 상태에 사용자가 남긴 메모가 있다"의 근거로 인용하지 말 것.**
  /// 소생시키지 않은 이유: 자유 문자열은 개인정보 밀도가 높은 축이라(파기 잡 phase 5·11이
  /// 이미 그런 문자열 둘을 뒤늦게 마스킹하고 있다) 받는 순간 보존·마스킹 판단이 함께 필요하고,
  /// 지금 이 메모를 보여 줄 화면도 없다. 없애려면 파괴적 마이그레이션이고
  /// `child_item_statuses`는 **DNC-007이 지키는 도메인**이라 변경 요청이 먼저다.
  statusNote     String?    @map("status_note") @db.VarChar(200)
  updatedByUserId String    @map("updated_by_user_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([childId, itemTemplateId], map: "uq_child_item_status")
  @@index([childId, status], map: "idx_child_item_statuses_child_status")
  @@map("child_item_statuses")
}

model ProductLink {
