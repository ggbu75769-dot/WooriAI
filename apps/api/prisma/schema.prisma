  @@unique([userId, endpoint, idemKey], map: "uq_idempotency_keys_user_endpoint_key")
  @@index([expiresAt], map: "idx_idempotency_keys_expires_at")
  @@map("idempotency_keys")
}

model Disclosure {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(80)
  text      String   @db.Text
  /// ⚠️ 죽은 플래그(GAP-066 #9에서 확인 — 라운드 65 코드 건강이 권고한 "선언만 있고
  /// 조건에 안 쓰이는 플래그" 스윕의 유일한 참조 0 항목). **아무도 읽지 않는다**:
  /// 앱이 읽는 경로(`items-catalog.service.ts`의 `disclosuresByKey`)도, 어드민 목록
  /// (`adminListDisclosures`)도 `where` 없이 전량을 읽는다. 쓰는 곳은 시드 한 곳뿐이고
  /// (`prisma/seed.ts` — 언제나 `true`, 컬럼 기본값과 같은 값이라 사실상 no-op)
  /// 두 실쓰기 경로(`AdminController.updateDisclosure`의 직접 upsert,
  /// `ContentRevisionsService.publishToLive`의 발행) 어느 쪽도 이 값을 건드리지 않는다.
  /// 즉 **끄는 수단도, 꺼진 것을 존중하는 판정도 없다.**
  /// **"이 고지는 지금 쓰이지 않는다"의 근거로 인용하지 말 것** — 값이 무엇이든
  /// 앱·어드민·클릭 응답은 그 문구를 계속 쓴다.
  /// 소생시키지 않은 이유(GAP-064 #9 `import_jobs.approved_at`·GAP-065 #9
  /// `disclosures.updated_by`와 같은 판단 형식, 세 번째 선례): 이 플래그를 존중하게
  /// 만드는 순간 그것이 곧 **DNC-010이 잠근 고지를 끄는 정식 스위치**가 된다 —
  /// 구매 CTA 인접 고지를 숨길 수 있는 수단을 만드는 일이라 소생이 곧 계약 위반이다.
  /// 없애려면 마이그레이션이 필요하므로(도메인 테이블의 파괴적 변경) 별도 티켓 대상이다.
  active    Boolean  @default(true)
  /// ⚠️ 죽은 컬럼(GAP-065 #9에서 확인). 저장소 전체에서 **읽지도 쓰지도 않는다**
  /// (grep 결과가 이 선언 한 줄뿐이다) — 두 쓰기 경로(`AdminController.updateDisclosure`의
  /// 직접 upsert, `ContentRevisionsService.publishToLive`의 발행) 어느 쪽도 채우지 않아
  /// 값은 항상 null이고, DTO로도 나가지 않는다.
  /// **"마지막 수정자"의 근거로 인용하지 말 것** — 그 답은 감사 로그에 있다:
  /// 행위자는 `audit_logs.actor_user_id`, 시각은 그 행의 `created_at`,
  /// 바뀐 문구는 `admin.disclosure.update`의 before/after 봉투다
  /// (admin.controller.ts). 소생시키지 않은 이유: 이 값을 조인 없이 읽어야 하는
  /// 화면이 아직 없고(`import_jobs.approved_at`과 다른 점이다 — GAP-064 #9),
  /// 어드민 계정 id를 행에 복사하면 계정 삭제 때 정리 대상이 하나 늘어난다.
  /// 없애려면 마이그레이션이 필요하므로 별도 티켓 대상이다.
  updatedBy String?  @map("updated_by") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("disclosures")
}

model AdminSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @map("last_seen_at") @db.Timestamptz(6)
  ip          String?   @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.Text
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  // 라운드 61 S-1(000021): SQL 전용 부분 인덱스 idx_admin_sessions_revoked_at
  // (revoked_at) WHERE revoked_at IS NOT NULL 이 별도로 존재한다(정리 워커의
  // OR revoked_at < cutoff 분기용, Prisma @@index 표현 불가 — 000011의
  // idx_refresh_tokens_revoked_at과 같은 관례).
  @@index([adminUserId], map: "idx_admin_sessions_admin_user_id")
  @@index([expiresAt], map: "idx_admin_sessions_expires_at")
  @@map("admin_sessions")
}

model ContentRevision {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String    @map("entity_type") @db.VarChar(32)
  entityId        String?   @map("entity_id") @db.Uuid
  revisionNo      Int       @map("revision_no")
  payload         Json      @db.JsonB
  status          String    @db.VarChar(16)
  authorAdminId   String    @map("author_admin_id") @db.Uuid
  reviewerAdminId String?   @map("reviewer_admin_id") @db.Uuid
  reviewNote      String?   @map("review_note") @db.Text
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  scheduledFor    DateTime? @map("scheduled_for") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entityType, entityId, revisionNo], map: "uq_content_revisions_entity_revision")
  @@index([status], map: "idx_content_revisions_status")
  @@index([entityType, entityId], map: "idx_content_revisions_entity")
  @@map("content_revisions")
}

model OauthTransaction {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      String    @db.VarChar(16)
  state         String    @unique @db.VarChar(64)
  nonceHash     String    @map("nonce_hash") @db.VarChar(128)
  codeChallenge String?   @map("code_challenge") @db.VarChar(128)
  redirectUri   String    @map("redirect_uri") @db.Text
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "idx_oauth_transactions_expires_at")
  @@map("oauth_transactions")
}

model AnalyticsEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventName       String   @map("event_name") @db.VarChar(64)
  eventVersion    Int      @map("event_version")
  eventId         String   @unique @map("event_id") @db.Uuid
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  userAnonId      String?  @map("user_anon_id") @db.VarChar(64)
  householdAnonId String?  @map("household_anon_id") @db.VarChar(64)
  appVersion      String?  @map("app_version") @db.VarChar(32)
  platform        String?  @db.VarChar(16)
  payload         Json     @db.JsonB

  @@index([eventName, occurredAt], map: "idx_analytics_events_name_occurred")
  // PERF-101(000011): occurred_at 단독 범위 윈도우(어드민 KPI 일별 집계·유니크
  // 사용자 카운트)용 — 위 복합 인덱스는 선두가 event_name이라 범위 스캔 불가.
  @@index([occurredAt], map: "idx_analytics_events_occurred_at")
  @@map("analytics_events")
}
