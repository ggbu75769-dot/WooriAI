model AffiliateClick {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable since migration 000008 (round5a-sprint2-plan.md §4, COM-106): the public
  // GET /r/:code redirect is unauthenticated, so an anonymous click has no logged-in
  // user/household/child. The existing authenticated POST /product-links/:id/click
  // path still fills these in.
  userId         String?         @map("user_id") @db.Uuid
  householdId    String?         @map("household_id") @db.Uuid
  childId        String?         @map("child_id") @db.Uuid
  itemTemplateId String          @map("item_template_id") @db.Uuid
  productLinkId  String          @map("product_link_id") @db.Uuid
  platform       ProductPlatform
  subId          String?         @map("sub_id") @db.VarChar(128)
  referrerScreenId String?       @map("referrer_screen_id") @db.VarChar(50)
  ipHash         String?         @map("ip_hash") @db.VarChar(128)
  userAgent      String?         @map("user_agent") @db.Text
  clickedAt      DateTime        @default(now()) @map("clicked_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productLinkId, clickedAt], map: "idx_affiliate_clicks_product_clicked")
  @@index([childId, clickedAt], map: "idx_affiliate_clicks_child_clicked")
  // PERF-101(000011): 어드민 대시보드 "최근 7일 클릭" 등 clicked_at 단독 범위용.
  @@index([clickedAt], map: "idx_affiliate_clicks_clicked_at")
  // ADM-123(000016): 어드민 클릭 통계 분해의 상위 링크 집계
  // (clicked_at 범위 + product_link_id GROUP BY)를 index-only로 처리한다.
  @@index([clickedAt, productLinkId], map: "idx_affiliate_clicks_clicked_product")
  @@map("affiliate_clicks")
}

/// 엑셀/CSV 가져오기의 **잡 헤더**(사용자에게 보이는 가져오기 이력).
///
/// GAP-063 #6 보존: `file_name`은 사용자가 고른 파일명 **원문**이라
/// (`imports.controller.ts`의 `file.originalname` — import.dto.ts SEC-115 F2 주석 참조)
/// 실사용에서 이름·카드사·기간 같은 식별정보를 담는다. 이 행은 `fk_expenses_import_job`
/// (000001)이 살아 있는 지출을 묶고 있어 **삭제할 수 없으므로**, 파기 잡 phase 11이
/// `IMPORT_ROWS_RETENTION_DAYS`(phase 9와 같은 창) 경과 후 `file_name`·`source_file_url`을
/// 자리표시자(`IMPORT_JOB_HEADER_MASK`)로 **마스킹**한다 — 행·FK·건수·시각은 그대로다.
/// 검수 중(`preview_ready`)인 잡은 대상이 아니다(사용자 자산).
model ImportJob {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  householdId    String       @map("household_id") @db.Uuid
  childId        String       @map("child_id") @db.Uuid
  fileName       String       @map("file_name") @db.VarChar(255)
  fileType       String       @map("file_type") @db.VarChar(10)
  fileSizeBytes  BigInt       @map("file_size_bytes") @db.BigInt
  status         ImportStatus
  sourceFileUrl  String?      @map("source_file_url") @db.Text
  rowCount       Int?         @map("row_count")
  candidateCount Int?         @map("candidate_count")
  importedCount  Int?         @map("imported_count")
  skippedCount   Int?         @map("skipped_count")
  errorCode      String?      @map("error_code") @db.VarChar(80)
  /// GAP-064 #9 — 이 가져오기가 **승인(확정)된 시각**의 단일 소스. NULL이면 아직 확정된 적이
  /// 없다는 뜻이다(`preview_ready`·`cancelled`·`failed`). 쓰는 곳은 하나뿐이다:
  /// `ImportPipelineService.confirmImport`의 확정 CAS(`preview_ready` -> `confirmed`)가
  /// 상태와 **같은 statement**로 적는다 — 그래서 "status=confirmed면 approved_at이 있다".
  /// (라운드 64 이전에는 읽기·쓰기가 0인 죽은 컬럼이었다. 이제는 아니다.)
  ///
  /// 지금은 **쓰기 전용**이다 — 어떤 응답 DTO에도 실리지 않아 어드민·앱에서 이 시각을 볼 수
  /// 없다. 감사 로그(`import.confirm`)가 "누가 언제"를 이미 답하므로 급하지 않지만, 어드민
  /// 가져오기 조회에 이 값을 싣는 것은 후속 작업이다(값이 없는 게 아니라 아직 안 보여줄 뿐).
  ///
  /// ⚠️ 파기 판정에 쓰이지 않는다: phase 9(미리보기 행 삭제)·phase 11(헤더 마스킹)은 둘 다
  /// `updated_at`을 정렬·컷오프 컬럼으로 쓴다(data-retention-purge.job.ts). 이 컬럼을 파기
  /// 창 계산에 끌어다 쓰지 말 것 — 그 순간 두 phase의 근거가 갈린다.
  /// 승인 **행위자**는 여기 없다(감사 로그 `import.confirm`의 actor가 답한다 —
  /// imports.controller.ts).
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  @@index([childId, status], map: "idx_import_jobs_child_status")
  @@map("import_jobs")
}

/// 업로드한 엑셀/CSV의 **검수용 파싱 결과**(승인 전 원본 줄 포함).
///
/// GAP-060 #5 보존: 확정(confirmed)·실패(failed) 잡의 행은
/// `data_retention_purge` 잡 phase 9가 `IMPORT_ROWS_RETENTION_DAYS`(기본 90일,
/// 근거는 잡 상수 주석) 경과 후 잡 단위로 통째 삭제한다. 검수 중
/// (`preview_ready`)인 잡의 행은 사용자 자산이라 대상이 아니며, 그 경우 아이/가구가
/// 파기될 때(phase 2·3 캐스케이드) 함께 사라진다.
model ImportRow {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importJobId                 String   @map("import_job_id") @db.Uuid
  rowIndex                    Int      @map("row_index")
  /// ⚠️ 죽은 컬럼(GAP-060 #5에서 확인). 이름과 달리 **원본 파일 줄이 들어간 적이 없다** —
  /// 유일한 쓰기 경로인 `ImportPipelineService.createImportJob`이 항상 `{}`를 넣고
  /// (`apps/api/src/onboarding/import-pipeline.service.ts`), 읽는 코드는 어디에도 없다
  /// (DTO에도 나가지 않는다). NOT NULL이라 지금은 빈 객체를 채워 넣는 것이 계약이다.
  /// 없애려면 마이그레이션이 필요하므로 별도 티켓 대상 — 그때까지 이 컬럼을 "원본 보관"
  /// 근거로 인용하지 말 것(파싱 원문은 파생 컬럼들에만 있다).
  rawJson                     Json     @map("raw_json") @db.JsonB
  parsedDate                  DateTime? @map("parsed_date") @db.Date
  parsedItemName              String?  @map("parsed_item_name") @db.VarChar(120)
  parsedAmountKrw             Int?     @map("parsed_amount_krw")
  categoryId                  String?  @map("category_id") @db.Uuid
  merchant                    String?  @db.VarChar(120)
  confidence                  Decimal  @default(0) @db.Decimal(4, 3)
  duplicateCandidateExpenseId String?  @map("duplicate_candidate_expense_id") @db.Uuid
  selected                    Boolean  @default(false)
  userReviewed                Boolean  @default(false) @map("user_reviewed")
  validationStatus            String   @default("ready") @map("validation_status") @db.VarChar(50)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([importJobId, rowIndex], map: "uq_import_rows_row_index")
  @@index([importJobId, selected], map: "idx_import_rows_job_selected")
  @@map("import_rows")
}

model Consent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  consentType String    @map("consent_type") @db.VarChar(60)
  version     String    @db.VarChar(30)
  accepted    Boolean
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipHash      String?   @map("ip_hash") @db.VarChar(128)
  userAgent   String?   @map("user_agent") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, consentType, version], map: "uq_consents_user_type_version")
  @@map("consents")
}

/// ⚠️ **죽은 테이블**(GAP-067 #8에서 확인 — 라운드 64 #9·65 #9·66 #9가 컬럼 단위로 세 번
/// 내린 판단을 처음으로 **표 단위**에 적용한 네 번째 선례다). 이 표에 행을 **만드는 코드가
/// 저장소 전체에 0건**이다: `create`도 `createMany`도 없고, `fileUrl`·`metadataJson`은
/// 스키마 선언 밖 참조가 0건, `uploadedByUserId`는 파기 잡에서만 나온다. 이 표를 언급하는
/// 유일한 제품 코드는 `data-retention-purge.job.ts`의 방어적 캐스케이드 네 자리뿐이고,
/// 그 넷은 모두 **언제나 빈 표**를 상대로 돈다(그 자리들의 주석 참고).
///
/// 채울 기능이 없는 것이 아니라 **잠겨 있다**: 사진/영수증은 DNC-016이 MVP 밖으로 못박은
/// 항목이라, 설계상 이 표는 계속 비어 있다. 즉 **살리는 것이 곧 범위 확대**이고, 그 판단은
/// 이 스키마가 아니라 DNC 변경 요청에서 시작해야 한다.
///
/// **"첨부 파일 기능이 있(었)다"의 근거로 인용하지 말 것.** 특히 파기 판정에서 —
/// "이 사용자는 첨부가 없어서 하드 삭제됐다"는 문장은 사실이 아니다(그 술어는 아무도
/// 채우지 않는 표를 보는 항진명제다).
///
/// 지우지 않은 이유: 테이블 DROP은 파괴적 마이그레이션이고, 인덱스 둘
/// (`idx_attachments_expense`·`idx_attachments_child`)과 파기 잡의 네 자리·`perf-indexes.db`
/// 계약이 함께 걸려 있어 한 번에 정리해야 한다. 다만 **`attachments`는 DNC-007의 도메인
/// 목록에 없다** — 계약이 지키는 표가 아니라 "쓸 일이 없어진 표"라는 뜻이고, 언젠가 지운다면
/// DNC 변경 요청이 아니라 평범한 파괴적 마이그레이션 티켓이다. 그 구분이 여기 적혀 있어야
/// 다음 사람이 지울 수 있는 것과 없는 것을 구별한다.
model Attachment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      String    @map("household_id") @db.Uuid
  childId          String    @map("child_id") @db.Uuid
  expenseId        String?   @map("expense_id") @db.Uuid
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  fileUrl          String    @map("file_url") @db.Text
  fileType         String    @map("file_type") @db.VarChar(30)
  fileSizeBytes    BigInt    @map("file_size_bytes") @db.BigInt
  metadataJson     Json?     @map("metadata_json") @db.JsonB
  status           String    @default("active") @db.VarChar(30)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  // PERF-115(000014): 파기 캐스케이드(expense_id IN UPDATE / child_id IN DELETE,
  // data-retention-purge.job.ts)가 30초 트랜잭션 안에서 도는 예방 인덱스.
  @@index([expenseId], map: "idx_attachments_expense")
  @@index([childId], map: "idx_attachments_child")
  @@map("attachments")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  householdId String?   @map("household_id") @db.Uuid
  action      String    @db.VarChar(80)
  targetType  String    @map("target_type") @db.VarChar(80)
  targetId    String?   @map("target_id") @db.Uuid
  beforeJson  Json?     @map("before_json") @db.JsonB
  afterJson   Json?     @map("after_json") @db.JsonB
  ipHash      String?   @map("ip_hash") @db.VarChar(128)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([householdId, createdAt], map: "idx_audit_logs_household_created")
  @@index([targetType, targetId], map: "idx_audit_logs_target")
  // ADM-113 감사 로그 뷰어 목록/필터 인덱스 (000012)
  @@index([createdAt, id], map: "idx_audit_logs_created_at")
  @@index([action, createdAt], map: "idx_audit_logs_action_created")
  @@index([actorUserId, createdAt], map: "idx_audit_logs_actor_created")
  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  jti        String    @unique @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // SEC-131(000019): 이 토큰이 속한 family가 처음 생성된(로그인) 시각. 회전 시
  // 그대로 승계되어 family 전체가 같은 값을 갖는다 — refresh 회전의 절대 수명
  // 상한(REFRESH_FAMILY_MAX_AGE_DAYS, 기본 90일) 판정 기준.
  // created_at의 MIN으로 대체할 수 없는 이유는 마이그레이션 헤더 참고.
  familyStartedAt DateTime @default(now()) @map("family_started_at") @db.Timestamptz(6)

  // PERF-101(000011): SQL 전용 부분 인덱스 idx_refresh_tokens_revoked_at
  // (revoked_at) WHERE revoked_at IS NOT NULL 이 별도로 존재한다(정리 워커의
  // OR revoked_at < cutoff 분기용, Prisma @@index 표현 불가).
  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([familyId], map: "idx_refresh_tokens_family_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

