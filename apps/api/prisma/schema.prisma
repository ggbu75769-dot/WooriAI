  normalizedSynonym String   @map("normalized_synonym") @db.VarChar(160)
  locale            String   @default("ko-KR") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([itemDefinitionId, normalizedSynonym, locale], map: "uq_item_synonyms_item_normalized_locale")
  @@index([normalizedSynonym, locale], map: "idx_item_synonyms_normalized_locale")
  @@map("item_synonyms")
}
