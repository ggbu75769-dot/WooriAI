{
  "expo": {
    "name": "우리아이",
    "slug": "wooriai",
    "scheme": "wooriai",
    "version": "0.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-asset",
      "./plugins/with-network-security-config"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.anonymous.wooriai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DB4F2E"
      }
    }
  }
}
