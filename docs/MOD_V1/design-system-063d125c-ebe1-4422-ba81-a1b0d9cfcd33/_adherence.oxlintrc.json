        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconBg|iconColor|title|subtitle|value|badge|onPress|style|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: icon, iconBg, iconColor, title, subtitle, value, badge, onPress, style."
