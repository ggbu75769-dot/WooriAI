{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/dataviz/**",
              "components/domain/**",
              "components/feedback/**",
              "components/forms/**",
              "components/overlay/**",
              "components/selection/**",
              "components/shell/**",
              "ui_kits/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard Variable))/i]",
        "message": "Font not provided by the design system. Available: Pretendard Variable."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessibleDataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|caption|style|key|ref|className|style|children)$/]",
        "message": "<AccessibleDataTable> doesn't accept that prop. Declared props: columns, rows, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavigation'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onSelect|tabs|style|key|ref|className|style|children)$/]",
        "message": "<BottomNavigation> doesn't accept that prop. Declared props: active, onSelect, tabs, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|action|onClose|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: title, children, action, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BudgetSummary'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|usedKrw|budgetKrw|ctaLabel|onCta|style|key|ref|className|style|children)$/]",
        "message": "<BudgetSummary> doesn't accept that prop. Declared props: label, usedKrw, budgetKrw, ctaLabel, onCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|disabled|icon|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, disabled, icon, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|medium)$/]",
        "message": "<Button> size must be one of 'large' | 'medium'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|subtle|brand|soft)$/]",
        "message": "<Card> variant must be one of 'default' | 'subtle' | 'brand' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartContainer'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|summary|recordCount|minRecords|emptyTitle|emptyDescription|emptyCtaLabel|onEmptyCta|tableColumns|tableRows|children|style|key|ref|className|style|children)$/]",
        "message": "<ChartContainer> doesn't accept that prop. Declared props: title, summary, recordCount, minRecords, emptyTitle, emptyDescription, emptyCtaLabel, onEmptyCta, tableColumns, tableRows, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|icon|layout|disabled|style|key|ref|className|style|children)$/]",
        "message": "<CheckCard> doesn't accept that prop. Declared props: checked, onChange, label, icon, layout, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|grid)$/]",
        "message": "<CheckCard> layout must be one of 'row' | 'grid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChildContextSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|stageLabel|onPress|style|key|ref|className|style|children)$/]",
        "message": "<ChildContextSwitcher> doesn't accept that prop. Declared props: name, stageLabel, onPress, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|helper|error|disabled|style|key|ref|className|style|children)$/]",
        "message": "<DateField> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, helper, error, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|confirmLabel|cancelLabel|destructive|onConfirm|onCancel|children|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: title, description, confirmLabel, cancelLabel, destructive, onConfirm, onCancel, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|image|title|description|ctaLabel|onCta|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, image, title, description, ctaLabel, onCta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorState'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|description|retryLabel|onRetry|style|key|ref|className|style|children)$/]",
        "message": "<ErrorState> doesn't accept that prop. Declared props: kind, title, description, retryLabel, onRetry, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorState'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:recoverable|fatal)$/]",
        "message": "<ErrorState> kind must be one of 'recoverable' | 'fatal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: selected, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|tone|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, tone, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|inverse)$/]",
        "message": "<IconButton> tone must be one of 'neutral' | 'brand' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemStatusControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|style|key|ref|className|style|children)$/]",
        "message": "<ItemStatusControl> doesn't accept that prop. Declared props: value, onChange, options, style."
