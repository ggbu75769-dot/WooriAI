      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute[name.name='sign'] > Literal[value!=/^(?:income|refund)$/]",
        "message": "<MoneyText> sign must be one of 'income' | 'refund'."
