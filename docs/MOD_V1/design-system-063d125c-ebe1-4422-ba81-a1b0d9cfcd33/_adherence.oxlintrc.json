        "selector": "JSXOpeningElement[name.name='MoneyField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|helper|error|disabled|style|key|ref|className|style|children)$/]",
        "message": "<MoneyField> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, helper, error, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MoneyText'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|size|sign|color|style|key|ref|className|style|children)$/]",
        "message": "<MoneyText> doesn't accept that prop. Declared props: amount, size, sign, color, style."
