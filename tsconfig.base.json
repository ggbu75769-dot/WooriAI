{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@wooriai/contracts": ["packages/contracts/src/index.ts"],
      "@wooriai/domain": ["packages/domain/src/index.ts"],
      "@wooriai/test-utils": ["packages/test-utils/src/index.ts"],
      "@wooriai/ui": ["packages/ui/src/index.ts"]
    }
  }
}
